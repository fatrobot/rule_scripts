# NAME: Claude Proxy Chain Rules
# AUTHOR: Enhanced from blackmatrix7
# UPDATED: 2025-07-18
# TOTAL: 15+

[filter_local]
HOST-SUFFIX,anthropic.com,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,claude.ai,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,api.anthropic.com,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,a-api.anthropic.com,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,auth.anthropic.com,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,accounts.anthropic.com,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,cdn.anthropic.com,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,assets.anthropic.com,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,static.anthropic.com,ClaudeProxy,via-interface=ClaudeHome

# 分析和监控服务
HOST,cdn.usefathom.com,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,segment.com,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,mixpanel.com,ClaudeProxy,via-interface=ClaudeHome

# 第三方资源
HOST-SUFFIX,googletagmanager.com,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,google-analytics.com,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,recaptcha.net,ClaudeProxy,via-interface=ClaudeHome
HOST-SUFFIX,gstatic.com,ClaudeProxy,via-interface=ClaudeHome

# WebSocket
HOST-SUFFIX,ws.anthropic.com,ClaudeProxy,via-interface=ClaudeHome

# 其他域名
HOST,claude.com,ClaudeProxy,via-interface=ClaudeHome
HOST,www.claude.ai,ClaudeProxy,via-interface=ClaudeHome
HOST,www.anthropic.com,ClaudeProxy,via-interface=ClaudeHome

FINAL,DIRECT

# Default traffic direct
FINAL,DIRECT
